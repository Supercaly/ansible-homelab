    {
      "id": 19,
      "type": "table",
      "title": "Guests",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 14,
        "h": 14
      },
      "targets": [
        {
          "expr": "sum by (id, name, type) (pve_guest_info{instance=\"$instance\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "id, name and type",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (id) (pve_up{instance=\"$instance\"} and on (id, instance) pve_guest_info)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "status",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (id) (pve_cpu_usage_limit{instance=\"$instance\"} and on (id, instance) pve_guest_info)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "vcpus",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (id) (pve_memory_size_bytes{instance=\"$instance\"} and on (id, instance) pve_guest_info)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "memsize",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (id) (pve_memory_usage_bytes{instance=\"$instance\",template!=\"1\"} / pve_memory_size_bytes and on (id, instance) pve_guest_info and on (id) pve_up==1)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "memusg_percent",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (id) (pve_disk_size_bytes{instance=\"$instance\"} and on (id, instance) pve_guest_info)",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "disksize",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "sum by (id) (pve_disk_usage_bytes{instance=\"$instance\"} / pve_disk_size_bytes and on (id, instance) pve_guest_info{type=\"lxc\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "diskusg_percent",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Value #id, name and type": true
            },
            "renameByName": {
              "Value #disksize": "Disk",
              "Value #diskusg_percent": "Disk usage (%)",
              "Value #memsize": "Memory",
              "Value #memusg_percent": "Memory usage (%)",
              "Value #status": "Status",
              "Value #vcpus": "vCPUs",
              "id": "ID",
              "name": "Name",
              "type": "Type"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
