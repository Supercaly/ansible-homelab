      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Network",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "8 * max((rate(pve_network_receive_bytes[$__rate_interval])) * on(id, instance) group_left(name) pve_guest_info{name=\"$guest\"})",
          "instant": false,
          "legendFormat": "rx",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "8 * max((rate(pve_network_transmit_bytes[$__rate_interval])) * on(id, instance) group_left(name) pve_guest_info{name=\"$guest\"})",
          "instant": false,
          "legendFormat": "tx",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
