          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "expr": "max((pve_memory_size_bytes) * on(id, instance) group_left(name) pve_guest_info{name=\"$guest\"})",
          "instant": false,
          "legendFormat": "Allocated",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
